{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "solidcraft": {
      "type": "stdio",
      "command": "nix",
      "args": ["develop", "--command", "solidcraft-cli", "mcp", "--param-check", "warn", "--allow-path", "hardware/lib"],
      "timeout": 120000
    },
    "egui": {
      "type": "stdio",
      "command": "nix",
      "args": ["develop", "--command", "egui-mcp"],
      "timeout": 120000
    }
  }
}
