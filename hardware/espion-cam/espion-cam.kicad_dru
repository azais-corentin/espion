(version 1)

# Spacing rules from docs/hardware/layout.md. Track widths and diff-pair geometry
# are in the net classes (Schematic Setup > Net Classes), sized for JLC04161H-7628.

# MIPI CSI-2: >= 2W (0.36 mm) to everything except the pair's own partner; this also keeps GND
# pour >= 0.30 mm away, which the 100 ohm geometry (0.18/0.15 mm) assumes.
(rule "MIPI_CSI spacing"
	(condition "A.NetClass == 'MIPI_CSI' && !A.isCoupledDiffPair() && !(A.memberOfFootprint('R45') && B.memberOfFootprint('R45')) && !(A.memberOfFootprint('R46') && B.memberOfFootprint('R46')) && !(A.memberOfFootprint('R47') && B.memberOfFootprint('R47')) && !(A.memberOfFootprint('R49') && B.memberOfFootprint('R49')) && !(A.memberOfFootprint('R50') && B.memberOfFootprint('R50')) && !(A.memberOfFootprint('R51') && B.memberOfFootprint('R51'))")
	(constraint clearance (min 0.36mm)))

# Ethernet MDI: 3x spacing (0.55 mm) to other nets (IP101G DS 6.2).
# Exempt inside U1's courtyard: its 0.4 mm pitch QFN pads (0.2 mm gap) can't hold 0.55 mm.
(rule "MDI spacing"
	(condition "A.NetClass == 'MDI' && B.NetClass != 'MDI' && !A.intersectsCourtyard('U1')")
	(constraint clearance (min 0.55mm)))

# USB 2.0: keep GND and other nets >= 0.30 mm from the 90 ohm pair (0.245/0.15 mm).
(rule "USB spacing"
	(condition "A.NetClass == 'USB' && !A.isCoupledDiffPair()")
	(constraint clearance (min 0.3mm)))

(rule "PoE isolation"
	(condition "A.NetClass == 'POE_CABLE' && B.NetClass != 'POE_CABLE' && !(A.memberOfFootprint('J1') && B.memberOfFootprint('J1'))")
	(constraint clearance (min 2mm)))

(rule "MIPI_CSI intra-pair skew"
	(condition "A.NetClass == 'MIPI_CSI'")
	(constraint skew (max 0.254mm) (within_diff_pairs)))

# LSM6DS3TR-C LGA-14: its land pattern puts pads 0.15-0.175 mm apart, under the 0.2 mm class
# clearance (JLCPCB's minimum is 0.1 mm). Pad pairs inside U12 only; tracks keep the class clearance.
(rule "U12 LGA pads" (condition "A.memberOfFootprint('U12') && B.memberOfFootprint('U12')") (constraint clearance (min 0.15mm)))

# USB-C receptacle: its CC and SBU pins sit 0.2 mm from the D+/D- pins, under the 0.3 mm
# 'USB spacing'. Pad pairs inside J2 only; must stay after 'USB spacing' (the last matching rule wins).
(rule "J2 USB pins" (condition "A.NetClass == 'USB' && A.memberOfFootprint('J2') && B.memberOfFootprint('J2')") (constraint clearance (min 0.2mm)))
