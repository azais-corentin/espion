(version 1)

# Spacing rules from SCHEMATIC.md (layout constraints). Track widths and diff-pair geometry
# are in the net classes (Schematic Setup > Net Classes), sized for JLC04161H-7628.

# MIPI CSI-2: >= 2W (0.36 mm) to everything except the pair's own partner; this also keeps GND
# pour >= 0.30 mm away, which the 100 ohm geometry (0.18/0.15 mm) assumes.
(rule "MIPI_CSI spacing"
	(condition "A.NetClass == 'MIPI_CSI' && !A.isCoupledDiffPair() && !(A.memberOfFootprint('R38') && B.memberOfFootprint('R38')) && !(A.memberOfFootprint('R39') && B.memberOfFootprint('R39')) && !(A.memberOfFootprint('R40') && B.memberOfFootprint('R40')) && !(A.memberOfFootprint('R41') && B.memberOfFootprint('R41')) && !(A.memberOfFootprint('R42') && B.memberOfFootprint('R42')) && !(A.memberOfFootprint('R43') && B.memberOfFootprint('R43'))")
	(constraint clearance (min 0.36mm)))

# Ethernet MDI: 3x spacing (0.55 mm) to other nets (IP101G DS 6.2).
# Exempt inside U6's courtyard: its 0.4 mm pitch QFN pads (0.2 mm gap) can't hold 0.55 mm.
(rule "MDI spacing"
	(condition "A.NetClass == 'MDI' && B.NetClass != 'MDI' && !A.intersectsCourtyard('U6')")
	(constraint clearance (min 0.55mm)))

# USB 2.0: keep GND and other nets >= 0.30 mm from the 90 ohm pair (0.245/0.15 mm).
(rule "USB spacing"
	(condition "A.NetClass == 'USB' && !A.isCoupledDiffPair()")
	(constraint clearance (min 0.3mm)))

(rule "PoE isolation"
	(condition "A.NetClass == 'POE_CABLE' && B.NetClass != 'POE_CABLE' && !(A.memberOfFootprint('J2') && B.memberOfFootprint('J2'))")
	(constraint clearance (min 2mm)))

(rule "MIPI_CSI intra-pair skew"
	(condition "A.NetClass == 'MIPI_CSI'")
	(constraint skew (max 0.254mm) (within_diff_pairs)))

