		(uuid "9df5112a-94af-4c2e-9f41-703b798b494f")
	)
	(text "U2 pin 5 (VBUS) is on +3V3:\non J1 VBUS, the P4's D+ pull-up\n(USB_PU) would hold an unplugged\nVBUS at ~2.7 V, not vSafe0V.\nD2 clamps VBUS instead."
		(exclude_from_sim no)
		(at 53.34 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f503ca11-a913-4847-8fc1-801331cf690f")
	)
