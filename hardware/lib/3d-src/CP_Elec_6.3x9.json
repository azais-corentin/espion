[
 {"command":"parameters.add","params":{"name":"D","expression":"6.3 mm","comment":"datasheet OD (size code 6.3)"}},
 {"command":"parameters.add","params":{"name":"L","expression":"9 mm","comment":"datasheet L (total height above PCB, 6.3x9 case)"}},
 {"command":"parameters.add","params":{"name":"A","expression":"6.6 mm","comment":"datasheet W/H (base plate size, 6.6 x 6.6)"}},
 {"command":"parameters.add","params":{"name":"C","expression":"7.2 mm","comment":"datasheet C (terminal tip to tip)"}},
 {"command":"parameters.add","params":{"name":"P","expression":"1.9 mm","comment":"datasheet P (gap between terminals)"}},
 {"command":"parameters.add","params":{"name":"Wt","expression":"0.65 mm","comment":"datasheet W (terminal width 0.5..0.8, mid value)"}},
 {"command":"parameters.add","params":{"name":"Tt","expression":"0.2 mm","comment":"terminal strip thickness (not in datasheet, typical)"}},
 {"command":"parameters.add","params":{"name":"Hb","expression":"1.0 mm","comment":"top of base plate above PCB (not in datasheet, typical)"}},
 {"command":"parameters.add","params":{"name":"Cb","expression":"1.0 mm","comment":"base plate corner chamfer on + side (not in datasheet, typical)"}},
 {"command":"parameters.add","params":{"name":"Rt","expression":"0.3 mm","comment":"can top rim rounding (approx.)"}},
 {"command":"parameters.add","params":{"name":"Vl","expression":"4.4 mm","comment":"vent cross groove length (approx.)"}},
 {"command":"parameters.add","params":{"name":"Vw","expression":"0.3 mm","comment":"vent cross groove width (approx.)"}},
 {"command":"parameters.add","params":{"name":"Vd","expression":"0.15 mm","comment":"vent cross groove depth (approx.)"}},
 {"command":"parameters.add","params":{"name":"Mt","expression":"0.05 mm","comment":"polarity mark ink thickness, inset into the can top so L stays 9 (approx.)"}},

 {"command":"solid.box","params":{"length":"A","width":"A","height":"Hb - Tt","center":[0,0,"(Hb + Tt)/2"],"operation":"new","body_name":"Base","name":"BasePlate"}},
 {"command":"solid.chamfer","params":{"edges":[[-3.3,3.3,0.6],[-3.3,-3.3,0.6]],"distance":"Cb","name":"PlusChamfer"}},

 {"command":"solid.cylinder","params":{"diameter":"D","height":"L - Hb","base":[0,0,"Hb"],"operation":"new","body_name":"Can","name":"CanBody"}},
 {"command":"solid.fillet","params":{"edges":[[3.15,0,9]],"radius":"Rt","body":"Can","name":"CanRim"}},
 {"command":"sketch.create","params":{"plane":"XY","offset":"L - Mt","name":"MarkSketch_x1.2_to_r2.75"}},
 {"command":"sketch.line","params":{"points":[[1.2,-2.4744],[1.2,2.4744]]}},
 {"command":"sketch.arc.three_point","params":{"start":[1.2,2.4744],"end":[1.2,-2.4744],"through":[2.75,0]}},
 {"command":"sketch.finish","params":{}},
 {"command":"solid.extrude","params":{"sketch":"MarkSketch_x1.2_to_r2.75","distance":"1 mm","operation":"cut","targets":["Can"],"name":"MarkInset"}},
 {"command":"solid.extrude","params":{"sketch":"MarkSketch_x1.2_to_r2.75","distance":"Mt","operation":"new","body_name":"Marking","name":"MarkPad"}},
 {"command":"solid.box","params":{"length":"Vl","width":"Vw","height":"2*Vd","center":[0,0,"L"],"operation":"cut","targets":["Can"],"name":"VentX"}},
 {"command":"solid.box","params":{"length":"Vw","width":"Vl","height":"2*Vd","center":[0,0,"L"],"operation":"cut","targets":["Can"],"name":"VentY"}},
 {"command":"solid.box","params":{"length":"Vl","width":"Vw","height":"2*Vd","center":[0,0,"L"],"operation":"cut","targets":["Marking"],"name":"MarkVentX"}},

 {"command":"solid.box","params":{"length":"(C - P)/2","width":"Wt","height":"Tt","center":["-(C + P)/4",0,"Tt/2"],"operation":"new","body_name":"Pin1_Plus","name":"Terminal1"}},
 {"command":"solid.box","params":{"length":"(C - P)/2","width":"Wt","height":"Tt","center":["(C + P)/4",0,"Tt/2"],"operation":"new","body_name":"Pin2_Minus","name":"Terminal2"}},

 {"command":"appearance.assign","params":{"bodies":["Base"],"color":"#1e1e1e","name":"base plastic black"}},
 {"command":"appearance.assign","params":{"bodies":["Can"],"color":"#c8cad2","name":"aluminium can"}},
 {"command":"appearance.assign","params":{"bodies":["Pin1_Plus","Pin2_Minus"],"color":"#e6e6e6","name":"tinned terminal"}},
 {"command":"appearance.assign","params":{"bodies":["Marking"],"color":"#b4141a","name":"polarity mark red (minus side)"}}
]
