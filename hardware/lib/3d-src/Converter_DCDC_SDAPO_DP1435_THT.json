 {"command":"solid.box","params":{"length":"Pw","width":"Pw","height":"Pb + Hh/2 + Pw/2","center":["p","0 mm","(Hh/2 + Pw/2 - Pb)/2"],"operation":"new","body_name":"Pin2","name":"Pin2Leg"}},
