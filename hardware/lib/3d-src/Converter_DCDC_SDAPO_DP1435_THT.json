 {"command":"solid.box","params":{"length":"Pw","width":"Pw","height":"Pb + Hh/2 + Pw/2","center":["3*p","0 mm","(Hh/2 + Pw/2 - Pb)/2"],"operation":"new","body_name":"Pin4","name":"Pin4Leg"}},
 {"command":"solid.box","params":{"length":"Pw","width":"Dp + Pt + Pw/2","height":"Pw","center":["3*p","(Dp + Pt - Pw/2)/2","Hh/2"],"operation":"join","targets":["Pin4"],"name":"Pin4Tail"}},
 {"command":"solid.box","params":{"length":"Pw","width":"Pw","height":"Pb + Hh/2 + Pw/2","center":["x5","0 mm","(Hh/2 + Pw/2 - Pb)/2"],"operation":"new","body_name":"Pin5","name":"Pin5Leg"}},
 {"command":"solid.box","params":{"length":"Pw","width":"Dp + Pt + Pw/2","height":"Pw","center":["x5","(Dp + Pt - Pw/2)/2","Hh/2"],"operation":"join","targets":["Pin5"],"name":"Pin5Tail"}},
