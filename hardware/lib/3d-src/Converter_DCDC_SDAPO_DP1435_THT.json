[
 {"command":"parameters.add","params":{"name":"L","expression":"35.6 mm","comment":"datasheet body length 35.6 (front view)"}},
 {"command":"parameters.add","params":{"name":"W","expression":"16.2 mm","comment":"datasheet overall depth 16.2 (side view / top view)"}},
 {"command":"parameters.add","params":{"name":"H","expression":"14.0 mm","comment":"datasheet body height 14.0 above the bottom edge (seated on PCB top)"}},
 {"command":"parameters.add","params":{"name":"xl","expression":"-1.29 mm","comment":"body left edge X rel. pin 1 (footprint F.Fab; pin row placement along the body provisional)"}},
 {"command":"parameters.add","params":{"name":"Tpcb","expression":"1.6 mm","comment":"datasheet p.3: module PCB thickness 1.6"}},
 {"command":"parameters.add","params":{"name":"Dp","expression":"4.5 mm","comment":"datasheet p.3: pin row to module PCB face 4.50"}},
 {"command":"parameters.add","params":{"name":"Dl","expression":"2.6 mm","comment":"datasheet p.3: component side away from pins, 16.2 - 1.6 - 12 = 2.6"}},
 {"command":"parameters.add","params":{"name":"p","expression":"2.54 mm","comment":"datasheet pin pitch 2.54 (pins 1-4, 5-6)"}},
 {"command":"parameters.add","params":{"name":"x5","expression":"30.48 mm","comment":"pin 5 X: pin 4 + 22.86 (datasheet 22.86, footprint)"}},
 {"command":"parameters.add","params":{"name":"Pw","expression":"0.64 mm","comment":"datasheet SQ0.64 square pins"}},
 {"command":"parameters.add","params":{"name":"Pb","expression":"4.3 mm","comment":"datasheet pin length below body 4.3"}},
 {"command":"parameters.add","params":{"name":"Hh","expression":"2.54 mm","comment":"datasheet p.3: right-angle header housing 2.54"}},
 {"command":"parameters.add","params":{"name":"Pt","expression":"3.0 mm","comment":"datasheet p.3: pin tail beyond housing 3.0 (through module PCB)"}},
 {"command":"parameters.add","params":{"name":"Tx0","expression":"13.2 mm","comment":"magnetics block offset from body left edge (scaled from drawing, approx.)"}},
 {"command":"parameters.add","params":{"name":"Tw","expression":"13.5 mm","comment":"magnetics block width (scaled from drawing, approx.)"}},
 {"command":"parameters.add","params":{"name":"Tz","expression":"0.5 mm","comment":"magnetics block bottom above body bottom (scaled from drawing, approx.)"}},

 {"command":"solid.box","params":{"length":"L","width":"Tpcb","height":"H","center":["xl + L/2","Dp + Tpcb/2","H/2"],"operation":"new","body_name":"ModulePCB","name":"ModulePCB"}},
 {"command":"solid.box","params":{"length":"Tw","width":"W - Dl - Tpcb","height":"H - Tz","center":["xl + Tx0 + Tw/2","Dp - (W - Dl - Tpcb)/2","(H + Tz)/2"],"operation":"new","body_name":"Magnetics","name":"Magnetics"}},
 {"command":"solid.box","params":{"length":"Tx0 - 1 mm","width":"2.5 mm","height":"H - Hh - 1.5 mm","center":["xl + Tx0/2","Dp - 1.25 mm","(H + Hh - 0.5 mm)/2"],"operation":"new","body_name":"Components","name":"FrontPartsLeft"}},
 {"command":"solid.box","params":{"length":"L - Tx0 - Tw - 1 mm","width":"2.5 mm","height":"H - Hh - 1.5 mm","center":["xl + (L + Tx0 + Tw)/2","Dp - 1.25 mm","(H + Hh - 0.5 mm)/2"],"operation":"new","body_name":"ComponentsR","name":"FrontPartsRight"}},
 {"command":"solid.box","params":{"length":"L - 2 mm","width":"Dl","height":"H - 3 mm","center":["xl + L/2","Dp + Tpcb + Dl/2","(H + 1 mm)/2"],"operation":"new","body_name":"ComponentsB","name":"BackParts"}},

 {"command":"solid.box","params":{"length":"4*p","width":"Hh","height":"Hh","center":["1.5*p","Dp - Hh/2","Hh/2"],"operation":"new","body_name":"Header1","name":"Header1to4"}},
