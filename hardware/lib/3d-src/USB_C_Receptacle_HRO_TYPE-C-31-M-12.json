{"commands": [
 {"command":"parameters.add","params":{"name":"mo_w","expression":"8.34 mm","comment":"HRO drawing 2020.12.08, front view: mouth (inner shell) width 8.34 +0.06/-0.02"}},
 {"command":"parameters.add","params":{"name":"mo_h","expression":"2.56 mm","comment":"Drawing front view: mouth height 2.56 +-0.04"}},
 {"command":"parameters.add","params":{"name":"wall","expression":"0.30 mm","comment":"Shell sheet thickness: (8.94 - 8.34)/2; also the 0.60 shield-slot width minus clearance"}},
 {"command":"parameters.add","params":{"name":"sh_w","expression":"mo_w + 2*wall","comment":"Drawing top view: shell width 8.94"}},
 {"command":"parameters.add","params":{"name":"sh_h","expression":"mo_h + 2*wall","comment":"Shell outer height 3.16 (front view)"}},
 {"command":"parameters.add","params":{"name":"sh_z0","expression":"0.10 mm","comment":"Shell bottom above the board: side view 3.26 overall height minus 3.16 shell"}},
 {"command":"parameters.add","params":{"name":"zc","expression":"sh_z0 + sh_h/2","comment":"Height of the mouth centre line"}},
 {"command":"parameters.add","params":{"name":"sh_len","expression":"7.35 mm","comment":"Drawing top view: shell length 7.35"}},
 {"command":"parameters.add","params":{"name":"front_y","expression":"-3.68 mm","comment":"3D Y of the mouth face: footprint y +3.68 = front shield slot 1.08 + side view 2.60 (mouth faces footprint +y, the board edge)"}},
 {"command":"parameters.add","params":{"name":"rear_y","expression":"front_y + sh_len","comment":"3D Y of the shell rear (footprint y -3.67)"}},
 {"command":"parameters.add","params":{"name":"cav_d","expression":"6.40 mm","comment":"Mouth cavity depth to the insulator face (not dimensioned; approx.)"}},
 {"command":"parameters.add","params":{"name":"tg_w","expression":"6.69 mm","comment":"Tongue width (USB Type-C receptacle tongue 6.69; front view scaled ~6.7)"}},
 {"command":"parameters.add","params":{"name":"tg_t","expression":"0.70 mm","comment":"Drawing front view: tongue thickness 0.70 +-0.05"}},
 {"command":"parameters.add","params":{"name":"tg_set","expression":"0.50 mm","comment":"Tongue tip set back from the mouth face (approx.)"}},
 {"command":"parameters.add","params":{"name":"tab_dn","expression":"1.01 mm","comment":"Drawing side view: 4-1.01, shield tab length below the board top"}},
 {"command":"parameters.add","params":{"name":"tabf_y","expression":"-1.08 mm","comment":"3D Y of the front shield tabs (footprint slot y 1.08)"}},
 {"command":"parameters.add","params":{"name":"tabf_l","expression":"0.80 mm","comment":"Drawing side view: 2-0.80, front tab width"}},
 {"command":"parameters.add","params":{"name":"tabr_y","expression":"3.10 mm","comment":"3D Y of the rear shield tabs (footprint slot y -3.10; 4.18 behind the front tabs)"}},
 {"command":"parameters.add","params":{"name":"tabr_l","expression":"1.10 mm","comment":"Drawing side view: 2-1.10, rear tab width"}},
 {"command":"parameters.add","params":{"name":"tab_x","expression":"8.64 mm","comment":"Drawing front/bottom view: 8.64 between the shield tab centres"}},
 {"command":"parameters.add","params":{"name":"blk_d","expression":"1.50 mm","comment":"Rear insulator band under the shell, depth (bottom view, scaled; approx.)"}},
 {"command":"parameters.add","params":{"name":"blk_w","expression":"6.90 mm","comment":"Rear insulator band width (bottom view, scaled; approx.)"}},
 {"command":"parameters.add","params":{"name":"peg_x","expression":"5.78 mm","comment":"Drawing front view: 2-0.50 locating pegs, 5.78 apart"}},
 {"command":"parameters.add","params":{"name":"peg_y","expression":"2.60 mm","comment":"3D Y of the pegs: drawing bottom view 6.28 from the mouth face (footprint holes y -2.6)"}},
 {"command":"parameters.add","params":{"name":"peg_d","expression":"0.50 mm","comment":"Drawing front view: peg diameter 0.50"}},
 {"command":"parameters.add","params":{"name":"peg_dn","expression":"0.50 mm","comment":"Peg length below the board top (front view, scaled; approx.)"}},
 {"command":"parameters.add","params":{"name":"ld_w","expression":"0.20 mm","comment":"Drawing top view: 16-0.20 +-0.05 lead width"}},
 {"command":"parameters.add","params":{"name":"ld_t","expression":"0.15 mm","comment":"Lead thickness (not dimensioned; assumed)"}},
 {"command":"parameters.add","params":{"name":"ld_out","expression":"0.40 mm","comment":"Drawing top view: leads stick out 0.40 +-0.10 behind the shell"}},
 {"command":"parameters.add","params":{"name":"s1","expression":"0.50 mm","comment":"Drawing bottom view: lead span 0.50 (B7/A7... inner pair)"}},
 {"command":"parameters.add","params":{"name":"s2","expression":"1.50 mm","comment":"Drawing bottom view: lead span 1.50"}},
 {"command":"parameters.add","params":{"name":"s3","expression":"2.50 mm","comment":"Drawing bottom view: lead span 2.50"}},
 {"command":"parameters.add","params":{"name":"s4","expression":"3.50 mm","comment":"Drawing bottom view: lead span 3.50"}},
 {"command":"parameters.add","params":{"name":"s5","expression":"4.55 mm","comment":"Drawing bottom view: lead span 4.55"}},
 {"command":"parameters.add","params":{"name":"s6","expression":"5.05 mm","comment":"Drawing bottom view: lead span 5.05"}},
 {"command":"parameters.add","params":{"name":"s7","expression":"6.15 mm","comment":"Drawing bottom view: lead span 6.15"}},
 {"command":"parameters.add","params":{"name":"s8","expression":"6.65 mm","comment":"Drawing bottom view: lead span 6.65"}},

 {"command":"sketch.create","params":{"plane":"XZ","offset":"front_y","name":"ShellSketch"}},
 {"command":"sketch.draw.dimensioned","params":{"command":"sketch.slot.overall","params":{"p0":[-4.47,-1.68],"p1":[4.47,-1.68],"width":3.16},"dimensions":{"length":"sh_w","width":"sh_h"}}},
 {"command":"sketch.dimension","params":{"entities":["origin","a1.center"],"type":"horizontal","value":"sh_w/2 - sh_h/2"}},
 {"command":"sketch.dimension","params":{"entities":["origin","a1.center"],"type":"vertical","value":"zc"}},
 {"command":"sketch.dimension","params":{"entities":["origin","a2.center"],"type":"vertical","value":"zc"}},
 {"command":"sketch.draw.dimensioned","params":{"command":"sketch.slot.overall","params":{"p0":[-4.17,-1.68],"p1":[4.17,-1.68],"width":2.56,"connect":false},"dimensions":{"length":"mo_w","width":"mo_h"}}},
 {"command":"sketch.dimension","params":{"entities":["origin","a3.center"],"type":"horizontal","value":"mo_w/2 - mo_h/2"}},
 {"command":"sketch.dimension","params":{"entities":["origin","a3.center"],"type":"vertical","value":"zc"}},
 {"command":"sketch.dimension","params":{"entities":["origin","a4.center"],"type":"vertical","value":"zc"}},
 {"command":"sketch.finish","params":{}},
 {"command":"solid.extrude","params":{"sketch":"ShellSketch","distance":"sh_len","operation":"new","body_name":"Shell","name":"ShellTube"}},
 {"command":"solid.box","params":{"length":"blk_w","width":"blk_d + 0.2 mm","height":"sh_z0 + wall + 0.15 mm","corner":["-blk_w/2","rear_y - blk_d","-0.1 mm"],"operation":"cut","targets":["Shell"],"name":"ShellRearCut"}},

 {"command":"sketch.create","params":{"plane":"XZ","offset":"front_y + cav_d","name":"InsulatorSketch"}},
 {"command":"sketch.draw.dimensioned","params":{"command":"sketch.slot.overall","params":{"p0":[-4.17,-1.68],"p1":[4.17,-1.68],"width":2.56},"dimensions":{"length":"mo_w","width":"mo_h"}}},
 {"command":"sketch.dimension","params":{"entities":["origin","a1.center"],"type":"horizontal","value":"mo_w/2 - mo_h/2"}},
 {"command":"sketch.dimension","params":{"entities":["origin","a1.center"],"type":"vertical","value":"zc"}},
 {"command":"sketch.dimension","params":{"entities":["origin","a2.center"],"type":"vertical","value":"zc"}},
 {"command":"sketch.finish","params":{}},
 {"command":"solid.extrude","params":{"sketch":"InsulatorSketch","distance":"sh_len - cav_d","operation":"new","body_name":"Insulator","name":"InsulatorPlug"}},
 {"command":"solid.box","params":{"length":"tg_w","width":"cav_d - tg_set + 0.2 mm","height":"tg_t","corner":["-tg_w/2","front_y + tg_set","zc - tg_t/2"],"operation":"join","targets":["Insulator"],"name":"Tongue"}},

 {"command":"solid.box","params":{"length":"blk_w","width":"blk_d","height":"sh_z0 + wall - ld_t","corner":["-blk_w/2","rear_y - blk_d","ld_t"],"operation":"new","body_name":"RearBlock","name":"RearInsulator"}},
 {"command":"solid.cylinder","params":{"diameter":"peg_d","height":"peg_dn + ld_t + 0.1 mm","base":["-peg_x/2","peg_y","-peg_dn"],"operation":"join","targets":["RearBlock"],"name":"PegL"}},
 {"command":"solid.cylinder","params":{"diameter":"peg_d","height":"peg_dn + ld_t + 0.1 mm","base":["peg_x/2","peg_y","-peg_dn"],"operation":"join","targets":["RearBlock"],"name":"PegR"}},

 {"command":"solid.box","params":{"length":"wall","width":"tabf_l","height":"zc + tab_dn","corner":["tab_x/2 - wall/2","tabf_y - tabf_l/2","-tab_dn"],"operation":"new","body_name":"Tab_FR","name":"TabFrontR"}},
 {"command":"solid.box","params":{"length":"wall","width":"tabf_l","height":"zc + tab_dn","corner":["-tab_x/2 - wall/2","tabf_y - tabf_l/2","-tab_dn"],"operation":"new","body_name":"Tab_FL","name":"TabFrontL"}},
 {"command":"solid.box","params":{"length":"wall","width":"tabr_l","height":"zc + tab_dn","corner":["tab_x/2 - wall/2","tabr_y - tabr_l/2","-tab_dn"],"operation":"new","body_name":"Tab_RR","name":"TabRearR"}},
 {"command":"solid.box","params":{"length":"wall","width":"tabr_l","height":"zc + tab_dn","corner":["-tab_x/2 - wall/2","tabr_y - tabr_l/2","-tab_dn"],"operation":"new","body_name":"Tab_RL","name":"TabRearL"}},

 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["-s8/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_A1","name":"LeadA1"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["-s7/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_B12","name":"LeadB12"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["-s6/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_A4","name":"LeadA4"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["-s5/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_B9","name":"LeadB9"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["-s4/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_B8","name":"LeadB8"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["-s3/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_A5","name":"LeadA5"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["-s2/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_B7","name":"LeadB7"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["-s1/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_A6","name":"LeadA6"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["s1/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_A7","name":"LeadA7"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["s2/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_B6","name":"LeadB6"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["s3/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_A8","name":"LeadA8"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["s4/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_B5","name":"LeadB5"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["s5/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_B4","name":"LeadB4"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["s6/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_A9","name":"LeadA9"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["s7/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_B1","name":"LeadB1"}},
 {"command":"solid.box","params":{"length":"ld_w","width":"ld_out + 0.3 mm","height":"ld_t","center":["s8/2","rear_y + (ld_out - 0.3 mm)/2","ld_t/2"],"operation":"new","body_name":"Lead_A12","name":"LeadA12"}},

 {"command":"appearance.assign","params":{"bodies":["Shell","Tab_FR","Tab_FL","Tab_RR","Tab_RL"],"color":"#C8C8C8"}},
 {"command":"appearance.assign","params":{"bodies":["Insulator","RearBlock"],"color":"#1A1A1A"}},
 {"command":"appearance.assign","params":{"bodies":["Lead_A1","Lead_B12","Lead_A4","Lead_B9","Lead_B8","Lead_A5","Lead_B7","Lead_A6","Lead_A7","Lead_B6","Lead_A8","Lead_B5","Lead_B4","Lead_A9","Lead_B1","Lead_A12"],"color":"#D4AF37"}}
]}
