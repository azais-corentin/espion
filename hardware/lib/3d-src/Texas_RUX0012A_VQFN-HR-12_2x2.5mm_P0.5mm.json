{"commands":[
 {"command":"parameters.add","params":{"name":"body_x","expression":"2.0 mm","comment":"TI SLVSEA3F p38 RUX0012A: body width 1.9-2.1 (nominal 2.0), KiCad X"}},
 {"command":"parameters.add","params":{"name":"body_y","expression":"2.5 mm","comment":"p38: body length 2.4-2.6 (nominal 2.5), KiCad Y"}},
 {"command":"parameters.add","params":{"name":"body_h","expression":"1.0 mm","comment":"p38: 1 MAX overall height (only a maximum is given)"}},
 {"command":"parameters.add","params":{"name":"term_t","expression":"0.05 mm","comment":"p38: standoff 0.00-0.05; terminals drawn as 0.05 slabs flush with the body edge"}},
 {"command":"parameters.add","params":{"name":"sp_w","expression":"0.2 mm","comment":"p38: 8X 0.15-0.25 small terminal width (pins 3-6, 9-12)"}},
 {"command":"parameters.add","params":{"name":"sp_l","expression":"0.4 mm","comment":"p38: 8X 0.3-0.5 small terminal length from the short edge"}},
 {"command":"parameters.add","params":{"name":"sp_pitch","expression":"0.5 mm","comment":"p38: 6X 0.5 pitch, 2X 1.5 span (x = +-0.25, +-0.75)"}},
 {"command":"parameters.add","params":{"name":"lp_w","expression":"0.35 mm","comment":"p38: 4X 0.25-0.45 large terminal width (pins 1, 2, 7, 8)"}},
 {"command":"parameters.add","params":{"name":"lp_l","expression":"0.85 mm","comment":"p38: 4X 0.75-0.95 large terminal length from the long edge"}},
 {"command":"parameters.add","params":{"name":"lp_y","expression":"0.35 mm","comment":"p38: 2X 0.7 between large-terminal centres (y = +-0.35)"}},
 {"command":"parameters.add","params":{"name":"dot_r","expression":"0.15 mm","comment":"Pin-1 index mark in the p38 'PIN 1 INDEX AREA' (top left); size not dimensioned"}},

 {"command":"solid.box","params":{"length":"body_x","width":"body_y","height":"body_h - term_t","center":[0,0,"(body_h + term_t)/2"],"operation":"new","body_name":"Body","name":"Body"}},
 {"command":"solid.cylinder","params":{"base":["-body_x/4","body_y/4","body_h"],"radius":"dot_r","height":"0.01 mm","operation":"new","body_name":"Pin1Mark","name":"Pin1Mark"}},

 {"command":"solid.box","params":{"length":"lp_l","width":"lp_w","height":"term_t","center":["-(body_x - lp_l)/2","lp_y","term_t/2"],"operation":"new","body_name":"Pin1","name":"Pin1"}},
 {"command":"solid.box","params":{"length":"lp_l","width":"lp_w","height":"term_t","center":["-(body_x - lp_l)/2","-lp_y","term_t/2"],"operation":"new","body_name":"Pin2","name":"Pin2"}},
 {"command":"solid.box","params":{"length":"lp_l","width":"lp_w","height":"term_t","center":["(body_x - lp_l)/2","-lp_y","term_t/2"],"operation":"new","body_name":"Pin7","name":"Pin7"}},
 {"command":"solid.box","params":{"length":"lp_l","width":"lp_w","height":"term_t","center":["(body_x - lp_l)/2","lp_y","term_t/2"],"operation":"new","body_name":"Pin8","name":"Pin8"}},

 {"command":"solid.box","params":{"length":"sp_w","width":"sp_l","height":"term_t","center":["-1.5*sp_pitch","-(body_y - sp_l)/2","term_t/2"],"operation":"new","body_name":"Pin3","name":"Pin3"}},
 {"command":"solid.box","params":{"length":"sp_w","width":"sp_l","height":"term_t","center":["-0.5*sp_pitch","-(body_y - sp_l)/2","term_t/2"],"operation":"new","body_name":"Pin4","name":"Pin4"}},
 {"command":"solid.box","params":{"length":"sp_w","width":"sp_l","height":"term_t","center":["0.5*sp_pitch","-(body_y - sp_l)/2","term_t/2"],"operation":"new","body_name":"Pin5","name":"Pin5"}},
 {"command":"solid.box","params":{"length":"sp_w","width":"sp_l","height":"term_t","center":["1.5*sp_pitch","-(body_y - sp_l)/2","term_t/2"],"operation":"new","body_name":"Pin6","name":"Pin6"}},
 {"command":"solid.box","params":{"length":"sp_w","width":"sp_l","height":"term_t","center":["-1.5*sp_pitch","(body_y - sp_l)/2","term_t/2"],"operation":"new","body_name":"Pin12","name":"Pin12"}},
 {"command":"solid.box","params":{"length":"sp_w","width":"sp_l","height":"term_t","center":["-0.5*sp_pitch","(body_y - sp_l)/2","term_t/2"],"operation":"new","body_name":"Pin11","name":"Pin11"}},
 {"command":"solid.box","params":{"length":"sp_w","width":"sp_l","height":"term_t","center":["0.5*sp_pitch","(body_y - sp_l)/2","term_t/2"],"operation":"new","body_name":"Pin10","name":"Pin10"}},
 {"command":"solid.box","params":{"length":"sp_w","width":"sp_l","height":"term_t","center":["1.5*sp_pitch","(body_y - sp_l)/2","term_t/2"],"operation":"new","body_name":"Pin9","name":"Pin9"}},

 {"command":"appearance.assign","params":{"bodies":["Body"],"color":"#2B2B2B"}},
