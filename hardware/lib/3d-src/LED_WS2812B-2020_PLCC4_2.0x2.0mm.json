{"commands":[
 {"command":"parameters.add","params":{"name":"body_x","expression":"2.20 mm","comment":"WS2812B-2020-V6 datasheet p2 Back View: package width 2.20 (pin sides), tolerance +-0.15; KiCad X"}},
 {"command":"parameters.add","params":{"name":"body_y","expression":"2.00 mm","comment":"p2 Back View: package length 2.00; KiCad Y"}},
 {"command":"parameters.add","params":{"name":"total_h","expression":"0.84 mm","comment":"p2 Side View: overall height 0.84"}},
 {"command":"parameters.add","params":{"name":"base_h","expression":"0.28 mm","comment":"p2 Side View: base (white housing with the terminals) height 0.28"}},
 {"command":"parameters.add","params":{"name":"epoxy_x","expression":"1.45 mm","comment":"Clear encapsulant block width: p2 Top View between the dashed lines and Side View upper block, scaled to 2.20 (approx.); full 2.00 length"}},
 {"command":"parameters.add","params":{"name":"term_gap","expression":"1.13 mm","comment":"p2 Back View: 1.13 between the inner edges of the left and right terminals"}},
 {"command":"parameters.add","params":{"name":"term_pitch_y","expression":"1.00 mm","comment":"p2 Back View: 1.00 between terminal centres along Y (DI-VDD)"}},
 {"command":"parameters.add","params":{"name":"term_l","expression":"0.78 mm","comment":"Terminal length along Y: p2 Back View, scaled to 2.00 (approx.)"}},
 {"command":"parameters.add","params":{"name":"notch_r","expression":"0.20 mm","comment":"Half-round notch in each terminal's outer edge: p2 Back/Top View, scaled (approx.)"}},
 {"command":"parameters.add","params":{"name":"pin1_note","expression":"1","unit":"","comment":"Orientation: the footprint's pads are the datasheet p2 top view (Pin Arrangement) rotated 180 deg, so this model is that view rotated 180 deg: terminal 1 (DO) at footprint pad 1 (-0.915, -0.55), i.e. model (-x, +y), not at the bottom right where the datasheet top view draws it"}},
 {"command":"parameters.add","params":{"name":"bar_w","expression":"0.52 mm","comment":"Bottom polarity bar (p2 Back View, black like the terminals; metal assumed): width scaled (approx.), full 2.00 length, on the pin 1/2 side"}},
 {"command":"parameters.add","params":{"name":"bar_x","expression":"-0.195 mm","comment":"Bottom polarity bar centre X: p2 Back View scaled (approx.), mirrored to the top view and rotated 180 deg"}},
 {"command":"parameters.add","params":{"name":"bar_t","expression":"0.05 mm","comment":"Bottom polarity bar thickness (not on the drawing; assumed)"}},
 {"command":"parameters.add","params":{"name":"die_h","expression":"0.10 mm","comment":"IC and LED die height inside the clear block (not on the drawing; assumed)"}},

 {"command":"solid.box","params":{"length":"body_x","width":"body_y","height":"base_h","center":[0,0,"base_h/2"],"operation":"new","body_name":"Base","name":"BaseBlock"}},
 {"command":"solid.box","params":{"length":"(body_x - term_gap)/2","width":"term_l","height":"base_h + 0.2 mm","center":["-(body_x + term_gap)/4","term_pitch_y/2","base_h/2"],"operation":"cut","targets":["Base"],"name":"Pocket1"}},
 {"command":"solid.box","params":{"length":"(body_x - term_gap)/2","width":"term_l","height":"base_h + 0.2 mm","center":["-(body_x + term_gap)/4","-term_pitch_y/2","base_h/2"],"operation":"cut","targets":["Base"],"name":"Pocket2"}},
 {"command":"solid.box","params":{"length":"(body_x - term_gap)/2","width":"term_l","height":"base_h + 0.2 mm","center":["(body_x + term_gap)/4","-term_pitch_y/2","base_h/2"],"operation":"cut","targets":["Base"],"name":"Pocket3"}},
 {"command":"solid.box","params":{"length":"(body_x - term_gap)/2","width":"term_l","height":"base_h + 0.2 mm","center":["(body_x + term_gap)/4","term_pitch_y/2","base_h/2"],"operation":"cut","targets":["Base"],"name":"Pocket4"}},
 {"command":"solid.box","params":{"length":"bar_w","width":"body_y + 0.2 mm","height":"bar_t + 0.1 mm","center":["bar_x",0,"(bar_t - 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"BarPocket"}},

 {"command":"solid.box","params":{"length":"(body_x - term_gap)/2","width":"term_l","height":"base_h","center":["-(body_x + term_gap)/4","term_pitch_y/2","base_h/2"],"operation":"new","body_name":"Pin1","name":"Pin1"}},
 {"command":"solid.box","params":{"length":"(body_x - term_gap)/2","width":"term_l","height":"base_h","center":["-(body_x + term_gap)/4","-term_pitch_y/2","base_h/2"],"operation":"new","body_name":"Pin2","name":"Pin2"}},
 {"command":"solid.box","params":{"length":"(body_x - term_gap)/2","width":"term_l","height":"base_h","center":["(body_x + term_gap)/4","-term_pitch_y/2","base_h/2"],"operation":"new","body_name":"Pin3","name":"Pin3"}},
 {"command":"solid.box","params":{"length":"(body_x - term_gap)/2","width":"term_l","height":"base_h","center":["(body_x + term_gap)/4","term_pitch_y/2","base_h/2"],"operation":"new","body_name":"Pin4","name":"Pin4"}},
 {"command":"solid.cylinder","params":{"base":["-body_x/2","term_pitch_y/2","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Pin1"],"name":"Notch1"}},
 {"command":"solid.cylinder","params":{"base":["-body_x/2","-term_pitch_y/2","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Pin2"],"name":"Notch2"}},
 {"command":"solid.cylinder","params":{"base":["body_x/2","-term_pitch_y/2","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Pin3"],"name":"Notch3"}},
 {"command":"solid.cylinder","params":{"base":["body_x/2","term_pitch_y/2","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Pin4"],"name":"Notch4"}},
 {"command":"solid.box","params":{"length":"bar_w","width":"body_y","height":"bar_t","center":["bar_x",0,"bar_t/2"],"operation":"new","body_name":"PolarityBar","name":"PolarityBar"}},

 {"command":"solid.box","params":{"length":"epoxy_x","width":"body_y","height":"total_h - base_h","center":[0,0,"(total_h + base_h)/2"],"operation":"new","body_name":"Encapsulant","name":"Encapsulant"}},
 {"command":"solid.box","params":{"length":"0.75 mm","width":"0.40 mm","height":"die_h + 0.1 mm","center":["0.10 mm","-0.33 mm","base_h + (die_h - 0.1 mm)/2"],"operation":"cut","targets":["Encapsulant"],"name":"PocketIC"}},
 {"command":"solid.box","params":{"length":"0.12 mm","width":"0.18 mm","height":"die_h + 0.1 mm","center":["0.33 mm","0.23 mm","base_h + (die_h - 0.1 mm)/2"],"operation":"cut","targets":["Encapsulant"],"name":"PocketG"}},
 {"command":"solid.box","params":{"length":"0.20 mm","width":"0.20 mm","height":"die_h + 0.1 mm","center":["0.01 mm","0.235 mm","base_h + (die_h - 0.1 mm)/2"],"operation":"cut","targets":["Encapsulant"],"name":"PocketR"}},
 {"command":"solid.box","params":{"length":"0.15 mm","width":"0.20 mm","height":"die_h + 0.1 mm","center":["-0.305 mm","0.225 mm","base_h + (die_h - 0.1 mm)/2"],"operation":"cut","targets":["Encapsulant"],"name":"PocketB"}},

 {"command":"solid.box","params":{"length":"0.75 mm","width":"0.40 mm","height":"die_h","center":["0.10 mm","-0.33 mm","base_h + die_h/2"],"operation":"new","body_name":"DieIC","name":"DieIC"}},
 {"command":"solid.box","params":{"length":"0.12 mm","width":"0.18 mm","height":"die_h","center":["0.33 mm","0.23 mm","base_h + die_h/2"],"operation":"new","body_name":"DieG","name":"DieG"}},
 {"command":"solid.box","params":{"length":"0.20 mm","width":"0.20 mm","height":"die_h","center":["0.01 mm","0.235 mm","base_h + die_h/2"],"operation":"new","body_name":"DieR","name":"DieR"}},
 {"command":"solid.box","params":{"length":"0.15 mm","width":"0.20 mm","height":"die_h","center":["-0.305 mm","0.225 mm","base_h + die_h/2"],"operation":"new","body_name":"DieB","name":"DieB"}},

 {"command":"appearance.assign","params":{"bodies":["Base"],"color":"#F2F0E8"}},
 {"command":"appearance.assign","params":{"bodies":["Pin1","Pin2","Pin3","Pin4","PolarityBar"],"color":"#C8C8C8"}},
 {"command":"appearance.assign","params":{"bodies":["Encapsulant"],"color":"#DCE6EA","opacity":0.25}},
 {"command":"appearance.assign","params":{"bodies":["DieIC"],"color":"#2B2B2B"}},
 {"command":"appearance.assign","params":{"bodies":["DieG"],"color":"#5FA85F"}},
 {"command":"appearance.assign","params":{"bodies":["DieR"],"color":"#C25050"}},
 {"command":"appearance.assign","params":{"bodies":["DieB"],"color":"#5070C0"}}
]}
