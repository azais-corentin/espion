{"commands":[
 {"command":"parameters.add","params":{"name":"body_x","expression":"2.00 mm","comment":"YY-0807RGBJ26-07-FJ datasheet p2: package length 2.00 (top view and side view), tolerance +-0.10; KiCad X (the footprint is the datasheet top view turned 90 deg CCW)"}},
 {"command":"parameters.add","params":{"name":"body_y","expression":"1.70 mm","comment":"p2 top view: package width 1.70; KiCad Y"}},
 {"command":"parameters.add","params":{"name":"total_h","expression":"0.85 mm","comment":"p2 side view and feature list: overall height 0.85"}},
 {"command":"parameters.add","params":{"name":"base_h","expression":"0.28 mm","comment":"p2 side view: substrate height 0.28"}},
 {"command":"parameters.add","params":{"name":"lens_x","expression":"1.20 mm","comment":"p2 side view 1.2 (clear block length) and top view 1.20 (between the top terminals); full 1.70 width. The slight draft of the side view is not modelled"}},
 {"command":"parameters.add","params":{"name":"pad_x","expression":"0.52 mm","comment":"p2 bottom view: terminal 0.52 along the 2.00 side; KiCad X"}},
 {"command":"parameters.add","params":{"name":"pad_y","expression":"0.69 mm","comment":"p2 bottom view: terminal 0.69 along the 1.70 side; KiCad Y"}},
 {"command":"parameters.add","params":{"name":"pad_gap","expression":"0.20 mm","comment":"p2 bottom view: 0.20 between the terminals of one end"}},
 {"command":"parameters.add","params":{"name":"pad_t","expression":"0.05 mm","comment":"Bottom terminal metal thickness (not on the drawing; assumed)"}},
 {"command":"parameters.add","params":{"name":"top_x","expression":"(body_x - lens_x)/2","comment":"Top-side terminal depth: p2 top view, outside the 1.20 clear block (0.40)"}},
 {"command":"parameters.add","params":{"name":"top_gap","expression":"0.11 mm","comment":"Gap between the two top-side terminals of one end: p2 top view, scaled (approx.)"}},
 {"command":"parameters.add","params":{"name":"top_t","expression":"0.03 mm","comment":"Top-side terminal metal thickness (not on the drawing; assumed)"}},
 {"command":"parameters.add","params":{"name":"notch_r","expression":"0.20 mm","comment":"Half-round castellation in each terminal's outer edge: p2 top and bottom views, scaled (approx.)"}},
 {"command":"parameters.add","params":{"name":"notch_y","expression":"pad_gap/2 + pad_y/2","comment":"Castellation centre on the terminal centre line: p2 top and bottom views (scaled 0.44-0.45 from the centre)"}},
 {"command":"parameters.add","params":{"name":"mark_t","expression":"0.02 mm","comment":"Polarity mark under the clear block, green on p2 top view, on the pin 1/4 end (p2 draws it slightly toward pin 1, the p8 tape view toward pin 4): size and position scaled from p2 (approx.); thickness assumed"}},
 {"command":"parameters.add","params":{"name":"pin1_note","expression":"1","unit":"","comment":"Orientation: footprint pad 1 (DOUT) at (-0.86, -0.525), so terminal 1 is at model (-x, +y); 2 VDD (+x, +y), 3 DIN (+x, -y), 4 GND (-x, -y): the p2 top view turned 90 deg CCW"}},

 {"command":"solid.box","params":{"length":"body_x","width":"body_y","height":"base_h","center":[0,0,"base_h/2"],"operation":"new","body_name":"Base","name":"Substrate"}},
 {"command":"solid.box","params":{"length":"pad_x","width":"pad_y","height":"pad_t + 0.1 mm","center":["-(body_x - pad_x)/2","notch_y","(pad_t - 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"PadPocket1"}},
 {"command":"solid.box","params":{"length":"pad_x","width":"pad_y","height":"pad_t + 0.1 mm","center":["(body_x - pad_x)/2","notch_y","(pad_t - 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"PadPocket2"}},
 {"command":"solid.box","params":{"length":"pad_x","width":"pad_y","height":"pad_t + 0.1 mm","center":["(body_x - pad_x)/2","-notch_y","(pad_t - 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"PadPocket3"}},
 {"command":"solid.box","params":{"length":"pad_x","width":"pad_y","height":"pad_t + 0.1 mm","center":["-(body_x - pad_x)/2","-notch_y","(pad_t - 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"PadPocket4"}},
 {"command":"solid.box","params":{"length":"top_x","width":"(body_y - top_gap)/2","height":"top_t + 0.1 mm","center":["-(body_x - top_x)/2","(body_y + top_gap)/4","base_h - top_t + (top_t + 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"TopPocket1"}},
 {"command":"solid.box","params":{"length":"top_x","width":"(body_y - top_gap)/2","height":"top_t + 0.1 mm","center":["(body_x - top_x)/2","(body_y + top_gap)/4","base_h - top_t + (top_t + 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"TopPocket2"}},
 {"command":"solid.box","params":{"length":"top_x","width":"(body_y - top_gap)/2","height":"top_t + 0.1 mm","center":["(body_x - top_x)/2","-(body_y + top_gap)/4","base_h - top_t + (top_t + 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"TopPocket3"}},
 {"command":"solid.box","params":{"length":"top_x","width":"(body_y - top_gap)/2","height":"top_t + 0.1 mm","center":["-(body_x - top_x)/2","-(body_y + top_gap)/4","base_h - top_t + (top_t + 0.1 mm)/2"],"operation":"cut","targets":["Base"],"name":"TopPocket4"}},
 {"command":"solid.cylinder","params":{"base":["-body_x/2","notch_y","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Base"],"name":"NotchBase1"}},
 {"command":"solid.cylinder","params":{"base":["body_x/2","notch_y","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Base"],"name":"NotchBase2"}},
 {"command":"solid.cylinder","params":{"base":["body_x/2","-notch_y","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Base"],"name":"NotchBase3"}},
 {"command":"solid.cylinder","params":{"base":["-body_x/2","-notch_y","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Base"],"name":"NotchBase4"}},

 {"command":"solid.box","params":{"length":"pad_x","width":"pad_y","height":"pad_t","center":["-(body_x - pad_x)/2","notch_y","pad_t/2"],"operation":"new","body_name":"Pin1","name":"Pin1"}},
 {"command":"solid.box","params":{"length":"pad_x","width":"pad_y","height":"pad_t","center":["(body_x - pad_x)/2","notch_y","pad_t/2"],"operation":"new","body_name":"Pin2","name":"Pin2"}},
 {"command":"solid.box","params":{"length":"pad_x","width":"pad_y","height":"pad_t","center":["(body_x - pad_x)/2","-notch_y","pad_t/2"],"operation":"new","body_name":"Pin3","name":"Pin3"}},
 {"command":"solid.box","params":{"length":"pad_x","width":"pad_y","height":"pad_t","center":["-(body_x - pad_x)/2","-notch_y","pad_t/2"],"operation":"new","body_name":"Pin4","name":"Pin4"}},
 {"command":"solid.box","params":{"length":"top_x","width":"(body_y - top_gap)/2","height":"top_t","center":["-(body_x - top_x)/2","(body_y + top_gap)/4","base_h - top_t/2"],"operation":"new","body_name":"Top1","name":"TopTerminal1"}},
 {"command":"solid.box","params":{"length":"top_x","width":"(body_y - top_gap)/2","height":"top_t","center":["(body_x - top_x)/2","(body_y + top_gap)/4","base_h - top_t/2"],"operation":"new","body_name":"Top2","name":"TopTerminal2"}},
 {"command":"solid.box","params":{"length":"top_x","width":"(body_y - top_gap)/2","height":"top_t","center":["(body_x - top_x)/2","-(body_y + top_gap)/4","base_h - top_t/2"],"operation":"new","body_name":"Top3","name":"TopTerminal3"}},
 {"command":"solid.box","params":{"length":"top_x","width":"(body_y - top_gap)/2","height":"top_t","center":["-(body_x - top_x)/2","-(body_y + top_gap)/4","base_h - top_t/2"],"operation":"new","body_name":"Top4","name":"TopTerminal4"}},
 {"command":"solid.cylinder","params":{"base":["-body_x/2","notch_y","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Pin1","Top1"],"name":"Notch1"}},
 {"command":"solid.cylinder","params":{"base":["body_x/2","notch_y","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Pin2","Top2"],"name":"Notch2"}},
 {"command":"solid.cylinder","params":{"base":["body_x/2","-notch_y","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Pin3","Top3"],"name":"Notch3"}},
 {"command":"solid.cylinder","params":{"base":["-body_x/2","-notch_y","-0.1 mm"],"radius":"notch_r","height":"base_h + 0.2 mm","operation":"cut","targets":["Pin4","Top4"],"name":"Notch4"}},

 {"command":"solid.box","params":{"length":"lens_x","width":"body_y","height":"total_h - base_h","center":[0,0,"(total_h + base_h)/2"],"operation":"new","body_name":"Encapsulant","name":"Encapsulant"}},
 {"command":"solid.box","params":{"length":"0.10 mm","width":"0.225 mm","height":"mark_t + 0.1 mm","center":["-0.54 mm","0.105 mm","base_h + (mark_t - 0.1 mm)/2"],"operation":"cut","targets":["Encapsulant"],"name":"MarkPocket"}},
 {"command":"solid.box","params":{"length":"0.10 mm","width":"0.225 mm","height":"mark_t","center":["-0.54 mm","0.105 mm","base_h + mark_t/2"],"operation":"new","body_name":"PolarityMark","name":"PolarityMark"}},

 {"command":"appearance.assign","params":{"bodies":["Base"],"color":"#F2F0E8"}},
 {"command":"appearance.assign","params":{"bodies":["Pin1","Pin2","Pin3","Pin4","Top1","Top2","Top3","Top4"],"color":"#C8C8C8"}},
 {"command":"appearance.assign","params":{"bodies":["Encapsulant"],"color":"#DCE6EA","opacity":0.25}},
 {"command":"appearance.assign","params":{"bodies":["PolarityMark"],"color":"#3CB043"}}
]}
