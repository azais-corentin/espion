{"commands":[
 {"command": "parameters.add", "params": {"name": "brd_l", "expression": "24.00 mm", "comment": "Waveshare dimension drawing: module width 24.00 (footprint X)"}},
 {"command": "parameters.add", "params": {"name": "brd_w", "expression": "20.00 mm", "comment": "Waveshare dimension drawing: module height 20.00 (footprint Y)"}},
 {"command": "parameters.add", "params": {"name": "brd_t", "expression": "0.85 mm", "comment": "Waveshare dimension drawing side view: PCB thickness 0.85"}},
 {"command": "parameters.add", "params": {"name": "h_tot", "expression": "3.30 mm", "comment": "Waveshare dimension drawing side view: overall height 3.30 (PCB + shield can)"}},
 {"command": "parameters.add", "params": {"name": "pitch", "expression": "1.00 mm", "comment": "Waveshare dimension drawing: stamp hole pitch 1.00"}},
 {"command": "parameters.add", "params": {"name": "n_lr", "expression": "17", "unit": "", "comment": "Pads per left/right edge (pins 1-17, 39-55 span 16.00); whole number, 1 or more"}},
 {"command": "parameters.add", "params": {"name": "n_tb", "expression": "21", "unit": "", "comment": "Pads per top/bottom edge (pins 18-38, 56-76 span 20.00); whole number, 1 or more"}},
 {"command": "parameters.add", "params": {"name": "hole_d", "expression": "0.50 mm", "comment": "Castellation half-hole diameter (not published; estimate from photos)"}},
 {"command": "parameters.add", "params": {"name": "pad_w", "expression": "0.60 mm", "comment": "Castellation pad width along the edge (not published; = footprint pad width, photos)"}},
 {"command": "parameters.add", "params": {"name": "pad_l", "expression": "0.80 mm", "comment": "Castellation pad length in from the board edge (not published; estimate from photos)"}},
 {"command": "parameters.add", "params": {"name": "cu_t", "expression": "0.035 mm", "comment": "Pad copper/ENIG thickness above the PCB top"}},
 {"command": "parameters.add", "params": {"name": "can_l", "expression": "21.70 mm", "comment": "Shield can X size (not dimensioned; measured on the product photo, 33 px/mm)"}},
 {"command": "parameters.add", "params": {"name": "can_w", "expression": "17.50 mm", "comment": "Shield can Y size (not dimensioned; measured on the product photo, 33 px/mm)"}},
 {"command": "solid.box", "params": {"length": "brd_l", "width": "brd_w", "height": "brd_t + cu_t", "center": [0, 0, "(brd_t + cu_t)/2"], "name": "PadFrame", "body_name": "Pads"}},
 {"command": "solid.box", "params": {"length": "brd_l - 2*pad_l", "width": "brd_w - 2*pad_l", "height": "3 mm", "center": [0, 0, 0], "operation": "cut", "name": "PadFrameInner"}},
 {"command": "solid.box", "params": {"length": "2 mm", "width": "pitch - pad_w", "height": "3 mm", "center": ["-brd_l/2", "-(n_lr/2)*pitch", 0], "operation": "cut", "name": "PadGapLR"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["PadGapLR"], "dir1": [0, 1, 0], "count1": "n_lr + 1", "spacing1": "pitch", "dir2": [1, 0, 0], "count2": 2, "spacing2": "brd_l", "name": "PadGapsLR"}},
 {"command": "solid.box", "params": {"length": "pitch - pad_w", "width": "2 mm", "height": "3 mm", "center": ["-(n_tb/2)*pitch", "-brd_w/2", 0], "operation": "cut", "name": "PadGapTB"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["PadGapTB"], "dir1": [1, 0, 0], "count1": "n_tb + 1", "spacing1": "pitch", "dir2": [0, 1, 0], "count2": 2, "spacing2": "brd_w", "name": "PadGapsTB"}},
 {"command": "solid.box", "params": {"length": "2*(brd_l/2 - (n_tb/2)*pitch) - 0.2 mm", "width": "2*(brd_w/2 - (n_lr/2)*pitch) - 0.2 mm", "height": "3 mm", "center": ["-brd_l/2", "-brd_w/2", 0], "operation": "cut", "name": "PadCorner"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["PadCorner"], "dir1": [1, 0, 0], "count1": 2, "spacing1": "brd_l", "dir2": [0, 1, 0], "count2": 2, "spacing2": "brd_w", "name": "PadCorners"}},
 {"command": "solid.box", "params": {"length": "brd_l", "width": "brd_w", "height": "brd_t", "center": [0, 0, "brd_t/2"], "name": "Board", "body_name": "ModulePCB"}},
 {"command": "solid.box", "params": {"length": "pad_l", "width": "pad_w", "height": "3 mm", "center": ["-brd_l/2 + pad_l/2", "-(n_lr - 1)/2*pitch", 0], "operation": "cut", "targets": ["ModulePCB"], "name": "PadPocketLR"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["PadPocketLR"], "dir1": [0, 1, 0], "count1": "n_lr", "spacing1": "pitch", "dir2": [1, 0, 0], "count2": 2, "spacing2": "brd_l - pad_l", "name": "PadPocketsLR"}},
 {"command": "solid.box", "params": {"length": "pad_w", "width": "pad_l", "height": "3 mm", "center": ["-(n_tb - 1)/2*pitch", "-brd_w/2 + pad_l/2", 0], "operation": "cut", "targets": ["ModulePCB"], "name": "PadPocketTB"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["PadPocketTB"], "dir1": [1, 0, 0], "count1": "n_tb", "spacing1": "pitch", "dir2": [0, 1, 0], "count2": 2, "spacing2": "brd_w - pad_l", "name": "PadPocketsTB"}},
 {"command": "solid.cylinder", "params": {"diameter": "hole_d", "height": "3 mm", "base": ["-brd_l/2", "-(n_lr - 1)/2*pitch", "-1 mm"], "operation": "cut", "name": "HalfHoleLR"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["HalfHoleLR"], "dir1": [0, 1, 0], "count1": "n_lr", "spacing1": "pitch", "dir2": [1, 0, 0], "count2": 2, "spacing2": "brd_l", "name": "HalfHolesLR"}},
 {"command": "solid.cylinder", "params": {"diameter": "hole_d", "height": "3 mm", "base": ["-(n_tb - 1)/2*pitch", "-brd_w/2", "-1 mm"], "operation": "cut", "name": "HalfHoleTB"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["HalfHoleTB"], "dir1": [1, 0, 0], "count1": "n_tb", "spacing1": "pitch", "dir2": [0, 1, 0], "count2": 2, "spacing2": "brd_w", "name": "HalfHolesTB"}},
 {"command": "solid.box", "params": {"length": "can_l", "width": "can_w", "height": "h_tot - brd_t", "center": [0, 0, "(h_tot + brd_t)/2"], "name": "ShieldCan", "body_name": "Shield"}},
 {"command": "solid.cylinder", "params": {"diameter": "1.1 mm", "height": "1 mm", "base": ["-9.15 mm", "-7.0 mm", "h_tot - 0.02 mm"], "operation": "cut", "targets": ["Shield"], "name": "ShieldDotRecess"}},
 {"command": "solid.cylinder", "params": {"diameter": "1.1 mm", "height": "0.01 mm", "base": ["-9.15 mm", "-7.0 mm", "h_tot - 0.02 mm"], "operation": "new", "name": "ShieldDot", "body_name": "ShieldMark"}},
 {"command": "solid.cylinder", "params": {"diameter": "0.45 mm", "height": "0.01 mm", "base": ["-11.55 mm", "8.88 mm", "brd_t"], "operation": "new", "name": "Pin1Dot", "body_name": "Pin1Mark"}},
 {"command": "appearance.assign", "params": {"bodies": ["ModulePCB"], "color": "#1d4f8c", "name": "module PCB blue"}},
 {"command": "appearance.assign", "params": {"bodies": ["Pads (1) (22)", "Pads (1) (7)", "Pads (1) (18)", "Pads (1) (20)", "Pads (1) (10)", "Pads (1) (2)", "Pads (1) (13)", "Pads (1) (6)", "Pads (1) (16)", "Pads (1) (3)", "Pads (1) (8)", "Pads (1) (21)", "Pads (1) (11)", "Pads (1) (12)", "Pads (1) (15)", "Pads (1) (17)", "Pads (1) (19)", "Pads (1) (9)", "Pads (1) (4)", "Pads (1) (14)", "Pads (1) (5)", "Pads (4)", "Pads (14)", "Pads (20)", "Pads (16)", "Pads (2)", "Pads (7)", "Pads (15)", "Pads (27)", "Pads (26)", "Pads (23)", "Pads (24)", "Pads (8)", "Pads (21)", "Pads (6)", "Pads (10)", "Pads (5)", "Pads (22)", "Pads (13)", "Pads (11)", "Pads (32)", "Pads (31)", "Pads (35)", "Pads (33)", "Pads (19)", "Pads (17)", "Pads (29)", "Pads (34)", "Pads (3)", "Pads (12)", "Pads (28)", "Pads (9)", "Pads (30)", "Pads (25)", "Pads (18)", "Pads (54)", "Pads (53)", "Pads (38)", "Pads (51)", "Pads (50)", "Pads (55)", "Pads (48)", "Pads (47)", "Pads (52)", "Pads (57)", "Pads (45)", "Pads (44)", "Pads (49)", "Pads (37)", "Pads (42)", "Pads (39)", "Pads (56)", "Pads (46)", "Pads (40)", "Pads (41)", "Pads (43)"], "color": "#d4a537", "name": "ENIG pads gold (the pad cuts split the frame into these 76 bodies)"}},
